[Unit]
Description=Music Scheduler Service
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/schedule-music
# ~/.deno/bin: yt-dlp needs a JS runtime for YouTube; systemd does not read .bashrc
Environment=PATH=/home/pi/.deno/bin:/home/pi/schedule-music/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/schedule-music/venv/bin/gunicorn --worker-class eventlet -w 1 --timeout 120 --bind 0.0.0.0:5000 wsgi:application
Restart=always
RestartSec=10
# Audio gets priority; yt-dlp/ffmpeg children lower themselves with nice -n 10
Nice=-5
MemoryHigh=600M

[Install]
WantedBy=multi-user.target
