# Copy to .env and adjust. All values are optional.

# Flask session/CSRF signing key. Leave empty and the app generates one on first
# start and appends it here. Changing it logs everyone out (remember-me still works).
# Generate manually: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JavaScript runtime used by yt-dlp to solve YouTube challenges.
# Empty = yt-dlp default (deno on PATH). Use "node" on 32-bit Pi OS (Deno has no armv7 build).
YTDLP_JS_RUNTIME=
# Absolute path to the runtime binary if it is not on the service PATH
YTDLP_JS_RUNTIME_PATH=

# Netscape cookies file, only when YouTube answers "Sign in to confirm you're not a bot".
# Export it from a secondary account, never your main one.
YTDLP_COOKIES_FILE=

# MP3 bitrate for downloads (128K is plenty for PA speakers and cheap to encode on a Pi)
YTDLP_AUDIO_QUALITY=128K
# Safety cap for playlist downloads
YTDLP_MAX_PLAYLIST_ITEMS=200
# Kill a download after this many seconds without any yt-dlp output
YTDLP_STALL_TIMEOUT=900
